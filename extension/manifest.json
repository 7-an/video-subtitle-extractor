{
  "manifest_version": 3,
  "name": "视频字幕提取插件",
  "description": "提取 YouTube 视频已有字幕轨；没有字幕时，用本地 Whisper 语音识别生成字幕。",
  "version": "0.1.1",
  "key": "",
  "permissions": [
    "activeTab",
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "视频字幕提取插件",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/shorts/*",
        "https://m.youtube.com/watch*",
        "https://m.youtube.com/shorts/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page.js"],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ]
    }
  ]
}
